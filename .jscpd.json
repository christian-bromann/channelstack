{
  "path": ["server", "codegen", "sdks", "integrations", "examples", "scenarios", "scripts", "test", "conformance"],
  "format": ["typescript", "javascript", "python"],
  "minLines": 15,
  "minTokens": 50,
  "threshold": 0,
  "gitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/generated/**",
    "**/.venv/**",
    "**/linear/schema/**",
    "**/resend-openapi.json"
  ],
  "reporters": ["console"],
  "exitCode": 1
}
