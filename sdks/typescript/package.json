{
  "name": "channelstack",
  "version": "0.0.0",
  "description": "A test harness for AI agents that live in Slack, GitHub, Linear and Notion.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/christian-bromann/channelstack.git" },
  "engines": { "node": ">=22" },
  "bin": { "channelstack": "bin/channelstack.mjs" },
  "files": ["bin", "dist"],
  "exports": {
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "optionalDependencies": {
    "@channelstack/server-darwin-arm64": "0.0.0",
    "@channelstack/server-darwin-x64": "0.0.0",
    "@channelstack/server-linux-arm64": "0.0.0",
    "@channelstack/server-linux-x64": "0.0.0",
    "@channelstack/server-win32-x64": "0.0.0"
  }
}
