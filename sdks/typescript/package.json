{
  "name": "channelstack",
  "version": "0.0.0",
  "description": "Test the apps and agents you build for Slack, GitHub, Linear, Notion, Resend and Gmail: fake platforms on localhost, the TypeScript SDK, Vitest fixtures and matchers.",
  "keywords": [
    "testing",
    "test-harness",
    "fake",
    "slack",
    "github",
    "linear",
    "notion",
    "resend",
    "gmail",
    "agents",
    "vitest"
  ],
  "homepage": "https://channelstack.dev",
  "bugs": {
    "url": "https://github.com/christian-bromann/channelstack/issues"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christian-bromann/channelstack.git",
    "directory": "sdks/typescript"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "channelstack": "bin/channelstack.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/sdks/typescript/client.d.ts",
      "default": "./dist/sdks/typescript/client.js"
    },
    "./client": {
      "types": "./dist/sdks/typescript/client.d.ts",
      "default": "./dist/sdks/typescript/client.js"
    },
    "./vitest": {
      "types": "./dist/integrations/vitest/index.d.ts",
      "default": "./dist/integrations/vitest/index.js"
    },
    "./checks": {
      "types": "./dist/integrations/checks/index.d.ts",
      "default": "./dist/integrations/checks/index.js"
    },
    "./vitest/setup": {
      "default": "./dist/integrations/vitest/setup.js"
    },
    "./vitest/global-setup": {
      "default": "./dist/integrations/vitest/global-setup.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "optionalDependencies": {
    "@channelstack/server-darwin-arm64": "0.0.0",
    "@channelstack/server-darwin-x64": "0.0.0",
    "@channelstack/server-linux-arm64": "0.0.0",
    "@channelstack/server-linux-x64": "0.0.0",
    "@channelstack/server-win32-x64": "0.0.0"
  },
  "peerDependencies": {
    "vitest": ">=5.0.0 <6"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
