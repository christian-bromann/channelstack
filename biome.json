{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!/api",
      "!docs",
      "!index.html",
      "!spec",
      "!sdks/typescript/generated",
      "!sdks/python",
      "!**/dist",
      "!.claude",
      "!**/*.md",
      "!phase-log"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
