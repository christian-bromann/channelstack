{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "scenarios/agents/*.ts", "scenarios/runners/typescript/*.ts"],
      "project": ["scripts/**/*.ts", "scenarios/**/*.ts"]
    },
    "server": {
      "entry": ["src/cli.ts", "src/**/*.test.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "codegen": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "sdks/typescript": {
      "entry": ["client.ts", "**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    "api": {
      "entry": ["*.d.ts", "examples/*.ts"],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["@vitest/runner"]
    }
  },
  "ignoreBinaries": ["uv", "portless"]
}
