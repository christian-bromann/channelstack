{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "scenarios/agents/*.ts",
        "scenarios/runners/typescript/*.ts",
        "integrations/vitest/*.ts",
        "examples/agents/*/agent.ts",
        "scripts/lib/slack-event-tap.ts",
        "test/acceptance/*.ts",
        "test/acceptance/examples/*.ts",
        "test/acceptance/stand-ins/*.ts",
        "test/acceptance/default-timeout/*.ts",
        "test/acceptance/wait-defaults/*.ts",
        "conformance/*.test.ts"
      ],
      "project": [
        "scripts/**/*.ts",
        "scenarios/**/*.ts",
        "conformance/**/*.ts",
        "integrations/**/*.ts",
        "examples/**/*.ts",
        "test/**/*.ts"
      ],
      "ignoreDependencies": ["git-cliff"]
    },
    "server": {
      "entry": ["src/cli.ts", "src/**/*.test.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "codegen": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "sdks/typescript": {
      "entry": ["client.ts", "**/*.test.ts"],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["vitest"]
    }
  },
  "ignoreBinaries": ["uv", "portless", "rustfmt"],
  "ignore": ["test/acceptance/examples/fixtures/**"]
}
