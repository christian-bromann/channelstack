{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "bun"],
    "paths": {
      "channelstack/client": ["./sdks/typescript/client.ts"],
      "channelstack/vitest": ["./integrations/vitest/index.ts"]
    }
  },
  "include": [
