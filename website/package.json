    "react-router-dom": "6.30.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/familjen-grotesk": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@lobehub/icons-static-svg": "1.106.0",
    "@mdx-js/react": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@types/estree": "1.0.10",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
