{
  "name": "channelstack-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The channelstack.dev website",
  "scripts": {
    "dev": "vite-react-ssg dev",
    "build": "vite-react-ssg build && node scripts/postbuild.mjs",
    "preview": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:samples": "tsc -p tsconfig.samples.json && node scripts/check-python-samples.mjs",
    "og": "node scripts/og.mjs",
    "deploy": "wrangler deploy",
    "preview:upload": "wrangler versions upload"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@fontsource-variable/familjen-grotesk": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@types/hast": "3.0.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/runner": "4.1.12",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "6.0.0",
    "shiki": "4.6.0",
    "typescript": "7.0.2",
    "unist-util-visit": "5.2.0",
    "vite": "8.3.8",
    "vite-react-ssg": "0.9.2",
    "vitest": "4.1.12",
    "wrangler": "4.165.0"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  }
}
