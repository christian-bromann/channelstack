    "remark-mdx-frontmatter": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "shiki": "4.6.0",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "vite": "8.3.8",
    "vite-react-ssg": "0.9.2",
