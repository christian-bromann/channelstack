    "test": "vitest run",
    "og": "node scripts/og.mjs",
    "deploy": "wrangler deploy",
    "preview:upload": "wrangler versions upload"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "minisearch": "7.2.0",
