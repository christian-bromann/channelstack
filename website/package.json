{
  "name": "channelstack-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The channelstack.dev website",
  "scripts": {
    "dev": "vite-react-ssg dev",
    "build": "vite-react-ssg build && node scripts/postbuild.mjs && node scripts/check-links.mjs",
