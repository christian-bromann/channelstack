{
  // Type-checks the TypeScript samples and docs examples shown on the site against the TypeScript SDK in
  // ../sdks/typescript and its Vitest integration, the sources of the published `channelstack` package.
  // The Python ones are type-checked with pyright at the repository root (samples/python/README.md), and the
  // Rust examples are compiled by `pnpm test:rust` there.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "channelstack": ["../sdks/typescript/client.ts"],
      "channelstack/client": ["../sdks/typescript/client.ts"],
      "channelstack/vitest": ["../integrations/vitest/index.ts"],
      "channelstack/checks": ["../integrations/checks/index.ts"],
      "vite": ["./node_modules/vite"],
      "vitest": ["./node_modules/vitest"],
      "vitest/*": ["./node_modules/vitest/*"]
    }
  },
  "include": ["samples/**/*.ts", "examples/**/*.ts"]
}
