{
  // Type-checks the TypeScript samples and docs examples shown on the site against the public API in ../api/*.d.ts.
  // The Python ones are type-checked with pyright at the repository root (samples/python/README.md), and the
  // Rust examples are compiled by `pnpm test:rust` there.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "channelstack": ["../api/index.d.ts"],
      "channelstack/vitest": ["../api/vitest.d.ts"],
      // The client is the TypeScript SDK itself: the contract in ../api has no `connect`.
      "channelstack/client": ["../sdks/typescript/client.ts"],
      "vite": ["./node_modules/vite"],
      "vitest": ["./node_modules/vitest"],
      "vitest/*": ["./node_modules/vitest/*"]
    }
  },
  "include": ["samples/**/*.ts", "examples/**/*.ts"]
}
