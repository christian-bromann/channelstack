{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Used once, by the preview job, when the Worker doesn't exist yet: `wrangler versions upload`
  // can't create a Worker. It is wrangler.jsonc without the custom domain, so creating the
  // Worker never touches channelstack.dev. Production deploys use wrangler.jsonc.
  "name": "channelstack-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
