{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets, plus a Worker (worker/index.ts) for /mcp and the docs pages, which it serves as
  // Markdown to a request that asks for it. Every other request is served straight from the assets.
  "name": "channelstack-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/mcp", "/mcp/", "/docs", "/docs/*"],
  },
  // Production serves channelstack.dev. Preview versions get *.workers.dev URLs.
  "routes": [{ "pattern": "channelstack.dev", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
}
