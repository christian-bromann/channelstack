{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets, plus a Worker for /mcp only (worker/index.ts): every other request is served
  // straight from the assets without running it.
  "name": "channelstack-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/mcp", "/mcp/"],
  },
  // Production serves channelstack.dev. Preview versions get *.workers.dev URLs.
  "routes": [{ "pattern": "channelstack.dev", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
}
